# HotFixAgent — secrets reference (NEVER commit real values)
# These are NOT loaded from a .env file at runtime; they are set as:
#   • Firebase secrets (backend):  firebase functions:secrets:set NAME
#   • GitHub repo secrets (CI):    Settings → Secrets and variables → Actions → Secrets
# This file just documents what you need.

# ── Firebase Cloud Functions secrets (backend) ──
GITHUB_TOKEN=            # PAT (or fine-grained token) with repo + workflow scope; used to repository_dispatch
SLACK_WEBHOOK_URL=       # Slack incoming webhook for the team channel
CALLBACK_TOKEN=          # random shared token; generate with: openssl rand -hex 32

# ── GitHub repo secrets (CI / Actions) ──
ANTHROPIC_API_KEY=       # Claude API key used by claude-code-action
HOTFIX_CALLBACK_URL=     # https://<region>-<project>.cloudfunctions.net/hotfixStatusCallback
CALLBACK_TOKEN=          # SAME value as the Firebase CALLBACK_TOKEN above

# ── GitHub repo VARIABLES (CI, non-secret; optional — have defaults) ──
# HOTFIX_BRANCH=main
# HOTFIX_BUILD_CMD=./gradlew assembleDebug
# HOTFIX_TEST_CMD=./gradlew testDebugUnitTest
# HOTFIX_JAVA_VERSION=17
# HOTFIX_MAX_TURNS=40
# HOTFIX_TRIGGER_PHRASE=@claude
